
# ==================================================
# Application
# ==================================================
APP_NAME=agentic-fullstack
APP_ENV=testing

# ==================================================
# UI Docker
# ==================================================
UI_IMAGE=agentic-ui
UI_TAG=testing
UI_CONTAINER_NAME=agentic-ui

UI_HOST_PORT=8080
UI_CONTAINER_PORT=8080

# ==================================================
# Nginx
# ==================================================
NGINX_SERVER_NAME=_
NGINX_ROOT=/usr/share/nginx/html
NGINX_INDEX=index.html

NGINX_HEALTH_PATH=/health
NGINX_HEALTH_RESPONSE=healthy

NGINX_CLIENT_MAX_BODY_SIZE=10m

NGINX_PROXY_CONNECT_TIMEOUT=10s
NGINX_PROXY_SEND_TIMEOUT=60s
NGINX_PROXY_READ_TIMEOUT=60s

NGINX_ASSET_CACHE=1y

# ==================================================
# API
# ==================================================
API_SERVICE_NAME=api
API_HOST=api
API_PORT=3000
API_CONTAINER_PORT=3000
API_BASE_PATH=/api/

# ==================================================
# Testing
# ==================================================
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.56.1-noble
PLAYWRIGHT_BASE_URL=http://ui:8080
PLAYWRIGHT_WORKERS=2
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_BROWSER=chromium

CI=true

# ==================================================
# Docker
# ==================================================
DOCKER_NETWORK=testing-network
DOCKER_NETWORK_DRIVER=bridge

# Service configuration from nginx.conf and the existing yard configuration.
NGINX_LISTEN_PORT=8080
NGINX_SERVER_NAME=_
NGINX_ROOT=/usr/share/nginx/html
NGINX_INDEX=index.html
NGINX_CLIENT_MAX_BODY_SIZE=10m
NGINX_HEALTH_PATH=/health
NGINX_HEALTH_RESPONSE=healthy
NGINX_PROXY_CONNECT_TIMEOUT=10s
NGINX_PROXY_SEND_TIMEOUT=60s
NGINX_PROXY_READ_TIMEOUT=60s
NGINX_ASSET_CACHE=1y

# The nginx config exposes an API proxy, but no API service implementation is
# present in this yard. Add the real dependency before testing API routes.
API_BASE_PATH=/api/
API_HOST=api
API_PORT=3000

# Integration test configuration; Compose DNS resolves ui-react-ts internally.
SERVICE_URL=http://ui-react-ts:8080/health
SPA_URL=http://ui-react-ts:8080/
EXPECTED_RESPONSE_TEXT=healthy
READY_TIMEOUT_SECONDS=60
READY_INTERVAL_SECONDS=2

# Keycloak service and health endpoints on the Compose network.
KEYCLOAK_BASE_URL=http://auth_keycloak:8080
KEYCLOAK_HEALTH_URL=http://auth_keycloak:9000/health/ready
KC_HOSTNAME=http://auth_keycloak:8080
READY_TIMEOUT_SECONDS=180
READY_INTERVAL_SECONDS=3

# Keycloak database settings. KC_DB_PASSWORD is injected by Compose from the
# CI secret environment and is intentionally not stored in this file.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak

# Realm/client configuration. Comma-separated redirect URIs/origins are
# applied to home-ui when the realm import file is generated.
UI_REDIRECT_URIS=http://localhost:5173/*
UI_WEB_ORIGINS=http://localhost:5173

# Local email capture; these values contain no credentials.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@home.local
SMTP_FROM_DISPLAY_NAME=Home
SMTP_STARTTLS=false
SMTP_SSL=false
